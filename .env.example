# Local development only. Production on Vercel uses COC_API_TOKEN directly
# and never reads these values.
#
# Secret shared with the local backend (backend/.env.local).
# The Vite dev/preview proxy sends it as the x-coc-proxy-secret header.
COC_PROXY_SECRET=

# Optional local backend origin used by the Vite dev/preview proxy.
# Defaults to http://127.0.0.1:8787
COC_API_BASE_URL=http://127.0.0.1:8787
